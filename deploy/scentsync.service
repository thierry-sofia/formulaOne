[Unit]
Description=ScentSync (= formulaOne) - consultation des formules (maBase)
After=network.target mssql-server.service
Wants=mssql-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/scentsync.env
ExecStart=/usr/bin/java -jar /home/ubuntu/scentsync.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
