# A copier en /home/ubuntu/scentsync.env (chmod 600), jamais dans Git.
# La base est sur le VPS : l'URL par defaut (localhost:1433) convient.
FORMULAONE_DB_USER=
FORMULAONE_DB_PASSWORD=
FORMULAONE_USER=admin
# Port vers lequel nginx (HTTPS 8091) envoie le trafic : ne pas mettre 8091, c'est celui de nginx
FORMULAONE_PORT=9091
FORMULAONE_PASSWORD=
# Optionnel :
# FORMULAONE_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=maBase;encrypt=true;trustServerCertificate=true
